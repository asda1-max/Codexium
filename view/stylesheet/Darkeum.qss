/* ═══════════════════════════════════════════════════════════════
   Codexium — Modern Dark Theme
   A polished, deep-dark UI with purple accent and soft edges.
   ═══════════════════════════════════════════════════════════════ */


/* ── Base ─────────────────────────────────────────────────────── */
QWidget {
    background-color: #0c0c10;
    color: #e4e4ed;
    font-family: "Segoe UI", "Inter", "Helvetica Neue", sans-serif;
    font-size: 13px;
    selection-background-color: #7c5cfc;
    selection-color: #ffffff;
}

QWidget[role="card"] {
    background-color: #151519;
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 16px;
}

QWidget[role="sidebar"] {
    background-color: #111115;
    border-right: 1px solid rgba(255, 255, 255, 0.06);
}

QWidget[role="toolbar"] {
    background-color: #111115;
    border-left: 1px solid rgba(255, 255, 255, 0.06);
}


/* ── QLabel ───────────────────────────────────────────────────── */
QLabel {
    background-color: transparent;
    color: #e4e4ed;
    font-size: 13px;
}

QLabel[role="title"] {
    color: #ffffff;
    font-size: 36px;
    font-weight: 700;
    letter-spacing: 1px;
}

QLabel[role="subtitle"] {
    color: #7c5cfc;
    font-size: 14px;
    font-weight: 600;
}

QLabel[role="brand"] {
    color: #7c5cfc;
    font-size: 42px;
    font-weight: 800;
}

QLabel[role="brand-sub"] {
    color: #6b6b80;
    font-size: 13px;
    font-weight: 400;
}

QLabel[role="field-label"] {
    color: #a0a0b8;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
}

QLabel[role="version"] {
    color: #4a4a5e;
    font-size: 11px;
}

QLabel[role="section-header"] {
    color: #9090a8;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
}

QLabel::disabled {
    color: #3a3a4a;
}


/* ── QLineEdit ────────────────────────────────────────────────── */
QLineEdit {
    background-color: #1a1a22;
    color: #e4e4ed;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 10px 16px;
    font-size: 14px;
}

QLineEdit:hover {
    border: 1px solid rgba(124, 92, 252, 0.3);
}

QLineEdit:focus {
    border: 1px solid #7c5cfc;
    background-color: #1e1e28;
}

QLineEdit:disabled {
    background-color: #111115;
    color: #3a3a4a;
    border: 1px solid rgba(255, 255, 255, 0.03);
}

QLineEdit[role="search"] {
    background-color: #151519;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 13px;
}

QLineEdit[role="search"]:focus {
    border: 1px solid rgba(124, 92, 252, 0.4);
    background-color: #1a1a22;
}

QLineEdit[role="title-editor"] {
    background-color: transparent;
    border: none;
    border-bottom: 2px solid rgba(255, 255, 255, 0.06);
    border-radius: 0px;
    padding: 8px 4px;
    font-size: 20px;
    font-weight: 700;
    color: #ffffff;
}

QLineEdit[role="title-editor"]:focus {
    border-bottom: 2px solid #7c5cfc;
    background-color: transparent;
}


/* ── QTextEdit ────────────────────────────────────────────────── */
QTextEdit {
    background-color: #111115;
    color: #d0d0de;
    border: 1px solid rgba(255, 255, 255, 0.04);
    border-radius: 12px;
    padding: 16px 20px;
    font-size: 14px;
    line-height: 1.7;
}

QTextEdit:focus {
    border: 1px solid rgba(124, 92, 252, 0.25);
}

QTextEdit:disabled {
    background-color: #0e0e12;
    color: #3a3a4a;
}


/* ── QPushButton ──────────────────────────────────────────────── */
QPushButton {
    background-color: #7c5cfc;
    color: #ffffff;
    border: none;
    border-radius: 10px;
    padding: 10px 24px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #8e72ff;
}

QPushButton:pressed {
    background-color: #6344d4;
}

QPushButton:disabled {
    background-color: #1e1e28;
    color: #3a3a4a;
}

/* -- Secondary / outline button -- */
QPushButton[role="secondary"] {
    background-color: rgba(124, 92, 252, 0.10);
    color: #a08cff;
    border: 1px solid rgba(124, 92, 252, 0.2);
}

QPushButton[role="secondary"]:hover {
    background-color: rgba(124, 92, 252, 0.18);
    border: 1px solid rgba(124, 92, 252, 0.35);
}

QPushButton[role="secondary"]:pressed {
    background-color: rgba(124, 92, 252, 0.25);
}

/* -- Danger / reset button -- */
QPushButton[role="reset"] {
    background-color: rgba(239, 68, 68, 0.12);
    color: #f87171;
    border: 1px solid rgba(239, 68, 68, 0.2);
}

QPushButton[role="reset"]:hover {
    background-color: rgba(239, 68, 68, 0.22);
    border: 1px solid rgba(239, 68, 68, 0.4);
}

QPushButton[role="reset"]:pressed {
    background-color: rgba(239, 68, 68, 0.30);
}

/* -- Ghost / text button -- */
QPushButton[role="ghost"] {
    background-color: transparent;
    color: #7c5cfc;
    border: none;
    padding: 6px 12px;
    font-size: 13px;
    font-weight: 600;
}

QPushButton[role="ghost"]:hover {
    background-color: rgba(124, 92, 252, 0.08);
    border-radius: 8px;
}

/* -- Smaller link-style button -- */
QPushButton[role="smaller"] {
    background-color: transparent;
    color: #7c5cfc;
    border: none;
    padding: 4px 8px;
    font-size: 12px;
    font-weight: 600;
    text-decoration: underline;
}

QPushButton[role="smaller"]:hover {
    color: #a08cff;
}

/* -- Sidebar action button -- */
QPushButton[role="sidebar-action"] {
    background-color: rgba(124, 92, 252, 0.08);
    color: #b0a0ff;
    border: 1px solid rgba(124, 92, 252, 0.12);
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 12px;
    font-weight: 600;
    text-align: left;
}

QPushButton[role="sidebar-action"]:hover {
    background-color: rgba(124, 92, 252, 0.16);
    border: 1px solid rgba(124, 92, 252, 0.25);
    color: #c8bcff;
}

/* -- Toolbar button -- */
QPushButton[role="toolbar-btn"] {
    background-color: #1a1a22;
    color: #b0b0c4;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
    padding: 12px 16px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton[role="toolbar-btn"]:hover {
    background-color: #22222e;
    color: #e4e4ed;
    border: 1px solid rgba(255, 255, 255, 0.10);
}

QPushButton[role="toolbar-btn"]:pressed {
    background-color: #181820;
}

/* -- Toolbar danger -- */
QPushButton[role="toolbar-danger"] {
    background-color: rgba(239, 68, 68, 0.06);
    color: #f87171;
    border: 1px solid rgba(239, 68, 68, 0.10);
    border-radius: 10px;
    padding: 12px 16px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton[role="toolbar-danger"]:hover {
    background-color: rgba(239, 68, 68, 0.14);
    border: 1px solid rgba(239, 68, 68, 0.25);
}

/* -- Save button (green accent) -- */
QPushButton[role="save"] {
    background-color: rgba(34, 197, 94, 0.12);
    color: #4ade80;
    border: 1px solid rgba(34, 197, 94, 0.2);
    border-radius: 10px;
    padding: 12px 16px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton[role="save"]:hover {
    background-color: rgba(34, 197, 94, 0.22);
    border: 1px solid rgba(34, 197, 94, 0.4);
}

QPushButton[role="save"]:pressed {
    background-color: rgba(34, 197, 94, 0.30);
}


/* ── QListWidget ──────────────────────────────────────────────── */
QListWidget {
    background-color: transparent;
    border: none;
    outline: none;
    padding: 4px;
    font-size: 13px;
}

QListWidget::item {
    background-color: transparent;
    color: #b0b0c4;
    border-radius: 8px;
    padding: 10px 14px;
    margin: 2px 0px;
}

QListWidget::item:hover {
    background-color: rgba(124, 92, 252, 0.06);
    color: #d0d0e0;
}

QListWidget::item:selected {
    background-color: rgba(124, 92, 252, 0.14);
    color: #ffffff;
    border: none;
}

QListWidget::item:selected:hover {
    background-color: rgba(124, 92, 252, 0.18);
}


/* ── QScrollBar (Vertical) ────────────────────────────────────── */
QScrollBar:vertical {
    background-color: transparent;
    width: 8px;
    margin: 4px 0px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 4px;
    min-height: 40px;
}

QScrollBar::handle:vertical:hover {
    background-color: rgba(255, 255, 255, 0.14);
}

QScrollBar::handle:vertical:pressed {
    background-color: rgba(124, 92, 252, 0.4);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

/* ── QScrollBar (Horizontal) ──────────────────────────────────── */
QScrollBar:horizontal {
    background-color: transparent;
    height: 8px;
    margin: 0px 4px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 4px;
    min-width: 40px;
}

QScrollBar::handle:horizontal:hover {
    background-color: rgba(255, 255, 255, 0.14);
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}


/* ── QToolTip ─────────────────────────────────────────────────── */
QToolTip {
    background-color: #1e1e28;
    color: #e4e4ed;
    border: 1px solid rgba(124, 92, 252, 0.2);
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}


/* ── QDialog ──────────────────────────────────────────────────── */
QDialog {
    background-color: #141418;
    border-radius: 12px;
}


/* ── QDialogButtonBox ─────────────────────────────────────────── */
QDialogButtonBox QPushButton {
    min-width: 80px;
    padding: 8px 20px;
}


/* ── QMessageBox ──────────────────────────────────────────────── */
QMessageBox {
    background-color: #141418;
}

QMessageBox QLabel {
    color: #e4e4ed;
    font-size: 13px;
}

QMessageBox QPushButton {
    min-width: 90px;
}


/* ── QStackedWidget ───────────────────────────────────────────── */
QStackedWidget {
    background-color: #0c0c10;
}


/* ── QFrame separator ─────────────────────────────────────────── */
QFrame[role="separator"] {
    background-color: rgba(255, 255, 255, 0.06);
    max-height: 1px;
}


/* ── QMenuBar ─────────────────────────────────────────────────── */
QMenuBar {
    background-color: #0a0a0e;
    color: #b0b0c4;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    padding: 4px 8px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 4px 12px;
    border-radius: 6px;
}

QMenuBar::item:selected {
    background-color: rgba(124, 92, 252, 0.12);
    color: #e4e4ed;
}

QMenuBar::item:pressed {
    background-color: rgba(124, 92, 252, 0.20);
}


/* ── QMenu ────────────────────────────────────────────────────── */
QMenu {
    background-color: #1a1a22;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 6px;
    color: #e4e4ed;
}

QMenu::item {
    padding: 8px 24px 8px 16px;
    border-radius: 6px;
}

QMenu::item:selected {
    background-color: rgba(124, 92, 252, 0.14);
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: rgba(255, 255, 255, 0.06);
    margin: 4px 8px;
}


/* ── QTabWidget / QTabBar ─────────────────────────────────────── */
QTabWidget::pane {
    background-color: #111115;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 8px;
}

QTabBar::tab {
    background-color: transparent;
    color: #6b6b80;
    border: none;
    padding: 8px 20px;
    font-weight: 600;
    font-size: 12px;
}

QTabBar::tab:selected {
    color: #7c5cfc;
    border-bottom: 2px solid #7c5cfc;
}

QTabBar::tab:hover:!selected {
    color: #b0b0c4;
}


/* ── QProgressBar ─────────────────────────────────────────────── */
QProgressBar {
    background-color: #1a1a22;
    border: none;
    border-radius: 4px;
    text-align: center;
    color: #e4e4ed;
    font-size: 11px;
    height: 8px;
}

QProgressBar::chunk {
    background-color: #7c5cfc;
    border-radius: 4px;
}


/* ── QStatusBar ───────────────────────────────────────────────── */
QStatusBar {
    background-color: #0a0a0e;
    color: #4a4a5e;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
    font-size: 11px;
}
